# =============================================================================
# DZPortfolio environment
#
# Copy to .env.local and fill in. .env.local is gitignored; .env.example is not,
# so never put a real value in this file.
#
# Variables prefixed NEXT_PUBLIC_ are inlined into the browser bundle at build
# time and are readable by anyone. Everything else is server-only and must stay
# that way.
# =============================================================================

# --- Site --------------------------------------------------------------------

# Public site origin, no trailing slash (e.g. https://danielzimba.dev).
# Used for canonical URLs, Open Graph tags and the sitemap. On Vercel preview
# deployments this falls back to VERCEL_URL when unset; production should
# always set it explicitly.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# GitHub handle only — NOT a full URL. "BasicCoder2", not
# "https://github.com/BasicCoder2". A full URL is tolerated and passed through,
# but the handle is the intended value.
NEXT_PUBLIC_GITHUB_USERNAME=

# Full LinkedIn profile URL (e.g. https://www.linkedin.com/in/daniel-zimba).
# A bare handle is tolerated and resolved against https://linkedin.com/in.
NEXT_PUBLIC_LINKEDIN_URL=

# Where the nav and hero "Download CV" buttons point. Leave empty to fall back
# to the bundled /assets/cv/daniel-zimba-cv.pdf.
NEXT_PUBLIC_RESUME_URL=

# --- Supabase ----------------------------------------------------------------
# From the Supabase dashboard: Settings -> API.
#
# Without these the site still builds and serves: content reads degrade to
# empty results and the public pages render their empty states. The admin area
# reports that it is unconfigured rather than failing obscurely.

# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The anon / publishable key. Public by design — every table it can reach is
# protected by Row-Level Security (supabase/migrations/0002_rls.sql), and it
# can read only published content.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OPTIONAL, AND SCRIPT-ONLY.
#
# The service_role key bypasses every Row-Level Security policy in the project.
# No application code reads it — the running site talks to Supabase as the
# signed-in user, never as service_role. It is used by exactly one thing:
#
#     pnpm content:import
#
# the one-off migration of the pre-database static content.
#
# Set it in .env.local on your own machine while you run that import, and do
# NOT add it to Vercel. If you have already imported your content, leave this
# blank.
SUPABASE_SERVICE_ROLE_KEY=

# --- Administrator -----------------------------------------------------------

# The single account allowed into /admin. Server-only: no NEXT_PUBLIC_ prefix,
# so it is never shipped to the browser.
#
# Authorization is a two-key check. This variable is the application half; the
# database half is the `is_admin` flag on the matching row in public.profiles,
# granted by running supabase/seed/grant-admin.sql. BOTH must name the same
# address or nothing is authorized.
#
# Unset means nobody can sign in. That is deliberate — an unconfigured
# deployment must not admit the first person who creates an account.
ADMIN_EMAIL=

# --- Contact form (Resend) ---------------------------------------------------
# Server-only configuration for app/api/contact/route.ts.
# All three are required together — the contact form returns 503 if any is
# missing. CONTACT_FROM_EMAIL must be on a domain verified in Resend.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
